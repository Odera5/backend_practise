<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <strong>Service project under <%= title %> viz:</strong>
  <ul>
    <% serviceProject.forEach((project)=>{ %>
        <li><span><a href="/project/<%= project.project_id %>"><%= project.title%></a></span></li>

    <%})%>
  </ul>
  <% if (user && user.role_name === 'admin') { %>
    <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit category</a></p>
  <% } %>
</main>
<%- include('partials/footer') %>
