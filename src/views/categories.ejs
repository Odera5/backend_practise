<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <ul>
    <% categories.forEach(function(category) { %>
      <li>
        <a class="category-link" href="/category/<%= category.category_id %>">
          <span><%= category.name %></span>
        </a>
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
