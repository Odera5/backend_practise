<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p><%= projectDetails.description %></p>
  <p>Location: <%= projectDetails.location %></p>
  <p>Date: <%= new Date(projectDetails.date).toLocaleDateString("en-GB", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric"
}) %></p>
<p><strong>Partner Organization</strong> - <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.name %></a></p>
<h3>Category for <%= title %>:  </h3>
<% categories.forEach((category)=>{ %>
<li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
<%})%>
</main>
<%- include('partials/footer') %>
