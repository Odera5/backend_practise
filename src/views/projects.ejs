<%- include('partials/header') %>
<main class="projects">
  <h1><%= title %></h1>
  <ul>
    <% projects.forEach(function(project) { %>
      <li>
       <span> <a class="project-link" href="/project/<%= project.project_id %>">
          <%= new Date(project.date).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
}) %>:<%= project.title %>
        </a></span> - <span><a href="/organization/<%= project.organization_id %>"><em>(<%= project.name %>)</em></a>
      </li></span>
    <% }); %>

    <% if (user && user.role_name === 'admin') { %>
      <p><a href="/new-project">Create New Project</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>
