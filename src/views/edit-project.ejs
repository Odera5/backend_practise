<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <form action="/edit-project/<%= Project.project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Project title: </label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= Project.title%>"
        required
        maxlength="150"
      />
    </div>

    <div class="form-group">
      <label for="description">Description: </label>
      <textarea id="description" name="description" required maxlength="500">
<%= Project.description%></textarea
      >
    </div>

    <div class="form-group">
      <label for="location">Location: </label>
      <input
        type="location"
        id="location"
        name="location"
        value="<%= Project.location%>"
        required
      />
    </div>
    <div class="form-group">
      <label for="date">Date: </label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= Project.date.toISOString().split('T')[0]%>"
        required
      />
    </div>
    <div class="form-group">
      <label for="organization">Organization: </label>
      <select required name="organization_id" id="organization">
        <option selected disabled value="">Select organization</option>
        <% projectOrganizations.forEach(projectOrganization=>{ %>
          <option value="<%= projectOrganization.organization_id %>"><%= projectOrganization.name %></option>

       <% })%>
      </select>
    </div>

    <button type="submit">Update project</button>
  </form>
</main>
<%- include('partials/footer') %>
